{
  // Copy this file to tasuki.config.jsonc and edit it. The file is optional: without one,
  // tasuki start runs on the defaults, and TASUKI_DATA_DIR, TASUKI_HOST, TASUKI_PORT and
  // TASUKI_PUBLIC_URL set what is below (D105).
  // Relative paths in this file resolve against the folder this file lives in.
  // ${VAR} expands from the environment; a .env next to this file is loaded first.
  "version": 1,

  // Where this instance keeps its state: tracker.db, store.db (Runs, accounts and the
  // settings), logs/, workspaces/. Left out, ~/.tasuki.
  "dataDir": "./data",

  "server": { "host": "127.0.0.1", "port": 8787, "allowInsecure": false },

  // Left out, nobody signs in. auth-builtin keeps the accounts in tasuki; the first admin
  // comes from the setup token in the start-up log (security-and-auth.md).
  // "auth": { "plugin": "@tasuki/auth-builtin", "session": { "ttl": "7d" } },
  // auth-http asks another system instead; the first person in raises themselves with it.
  // "auth": { "plugin": "@tasuki/auth-http", "options": { "url": "https://sso.example.com/verify" } },

  // The tracker is not in this file: it is picked on the Tracker page under the gear, for an
  // admin, sqlite until then. A Jira token typed there is kept encrypted with a key made in
  // dataDir, or TASUKI_SECRET_KEY (D105, D106).

  // The statuses, the rules and the hold label are not in this file either: they live in the
  // store and are edited on the Workflow page, for an admin or a maintainer. A store never
  // saved to runs the default statuses with no rules, so the engine leaves every item alone
  // until a rule is added there (D91).

  // Agents are runner plugins, a package name and its options. The fake runner stands in
  // for an agent so the engine can be tried without an LLM. A title with [fake:needs_input], [fake:failed], [fake:blocked_manual], [fake:hang] or
  // [fake:no_tasks] picks what it does; anything else makes two tasks and succeeds after
  // `seconds`, [fake:manual] making the second one manual. Executing, it walks every task it
  // can to done and reports blocked_manual when only manual ones are left.
  //
  // Rules on the settings page pick one of these by name. Point one at "claude" to run the real CLI with this machine's login. It may
  // use the tasuki tools and allowedTools only; nobody is there to approve anything else.
  // It loads none of this machine's Claude settings: give it what it needs with "plugins",
  // "mcpServers" and "appendSystemPromptFile" (its standing instructions). A stage that needs
  // different ones gets an agent of its own.
  "agents": {
    "fake": { "plugin": "@tasuki/fake-runner", "options": { "seconds": 10 } },
    "claude": {
      "plugin": "@tasuki/claude-cli",
      "options": {
        "allowedTools": ["Read", "Edit", "Write", "Glob", "Grep", "Bash(git:*)", "Bash(node:*)"],
      },
    },
  },

  // The poll interval and the limits are on the General page (the gear on the board), for an
  // admin: 5 seconds on sqlite, 30 on Jira, until someone saves another.
}
