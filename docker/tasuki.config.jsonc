{
  // The config for the container image: mounted at /instance, its state in the /data volume.
  "version": 1,
  "dataDir": "/data",

  // Inside the container the engine has to listen on every address; compose.yaml publishes the
  // port on the host's loopback only, which is what allowInsecure owns (D90). Reached from
  // anywhere else, set auth and publicUrl instead.
  "server": { "host": "0.0.0.0", "port": 8787, "allowInsecure": true },

  // There is no login to inherit in here: on the Agents page under the gear, set the claude
  // agent's sign-in to an API key from the Claude Console, or to a token from claude
  // setup-token, and paste it there; it is kept encrypted in /data (D106, D107).
}
