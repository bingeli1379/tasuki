{
  "name": "tasuki",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r build && vp run -r --parallel dev",
    "check": "vp check && vp run -r typecheck",
    "format": "vp fmt",
    "test": "vp test",
    "e2e": "pnpm --filter @tasuki/web e2e",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "@tasuki/claude-cli": "workspace:*",
    "@tasuki/fake-runner": "workspace:*",
    "@tasuki/jira-cloud": "workspace:*",
    "@tasuki/sqlite": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.22.0"
  },
  "packageManager": "pnpm@12.14.0"
}
